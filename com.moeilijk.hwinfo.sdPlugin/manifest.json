{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"Actions": [
		{
			"Icon": "actionIcon",
			"Name": "HWiNFO",
			"States": [
				{
					"Image": "defaultImage",
					"TitleAlignment": "top",
					"FontSize": 9,
					"TitleColor": "#b7b7b7",
					"ShowTitle": false
				}
			],
			"SupportedInMultiActions": false,
			"Tooltip": "Display a sensor reading from HWiNFO",
			"UUID": "com.moeilijk.hwinfo.reading"
		},
		{
			"Icon": "actionIcon_composite",
			"Name": "Composite Dashboard",
			"States": [
				{
					"Image": "defaultImage",
					"ShowTitle": false
				}
			],
			"SupportedInMultiActions": false,
			"Tooltip": "Display 2–4 sensor readings on one tile with overlaid graphs",
			"UUID": "com.moeilijk.hwinfo.composite",
			"PropertyInspectorPath": "composite_pi.html"
		},
		{
			"Icon": "actionIcon_derived",
			"Name": "Derived Metric",
			"States": [
				{
					"Image": "defaultImage",
					"ShowTitle": false
				}
			],
			"SupportedInMultiActions": false,
			"Tooltip": "Aggregate 2–8 sensor readings with sum, average, max, min, delta or pct formula",
			"UUID": "com.moeilijk.hwinfo.derived",
			"PropertyInspectorPath": "derived_pi.html"
		},
		{
			"Icon": "actionIcon",
			"Name": "Dial Carousel",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A0",
				"TriggerDescription": {
					"Rotate": "Cycle reading"
				}
			},
			"States": [
				{
					"Image": "defaultImage",
					"ShowTitle": false
				}
			],
			"SupportedInMultiActions": false,
			"Tooltip": "Display one sensor reading on the Stream Deck+ touch strip and rotate the dial to cycle readings",
			"UUID": "com.moeilijk.hwinfo.dial",
			"PropertyInspectorPath": "dial_pi.html"
		},
		{
			"Icon": "actionIcon_gear_white",
			"Name": "Settings",
			"States": [
				{
					"Image": "settingsImage",
					"Title": "Refresh Rate",
					"TitleAlignment": "top",
					"FontSize": 9,
					"TitleColor": "#b7b7b7",
					"ShowTitle": false
				}
			],
			"SupportedInMultiActions": false,
			"Tooltip": "Configure HWiNFO plugin settings and sensor sources",
			"UUID": "com.moeilijk.hwinfo.settings",
			"PropertyInspectorPath": "settings_pi.html"
		}
	],
	"Author": "moeilijk",
	"CodePath": "hwinfo.exe",
	"PropertyInspectorPath": "index_pi.html",
	"Description": "Display hardware sensor readings from HWiNFO64 (shared memory). Not affiliated with HWiNFO64; see https://www.hwinfo.com",
	"Name": "HWiNFO",
	"UUID": "com.moeilijk.hwinfo",
	"Icon": "pluginIcon",
	"CategoryIcon": "categoryIcon",
	"URL": "https://github.com/moeilijk/hwinfo-streamdeck",
	"Version": "3.1.1.0",
	"ApplicationsToMonitor": {
		"windows": [
			"HWiNFO64.EXE",
			"HWiNFO64.exe"
		]
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Category": "HWiNFO"
}